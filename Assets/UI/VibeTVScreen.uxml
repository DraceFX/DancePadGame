<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project:/Assets/UI/VibeArcadeStyles.uss" />
    <ui:VisualElement name="tv-root" class="screen-wrapper" style="padding: 0; background-color: #0e061e;">
        <!-- Top HUD Bar -->
        <ui:VisualElement name="tv-top-bar" style="height: 110px; background-color: rgba(22, 11, 45, 0.95); border-bottom-width: 4px; border-bottom-color: #ff007f; flex-direction: row; align-items: center; justify-content: space-between; padding: 0 50px;">
            <ui:VisualElement style="flex-direction: row; align-items: center;">
                <ui:Label name="tv-song-name" text="Decadence — Disturbed" style="font-size: 40px; color: #ffffff;" />
            </ui:VisualElement>

            <!-- 65% Goal Marker -->
            <ui:VisualElement style="align-items: center;">
                <ui:Label name="tv-goal-marker" text="▲ 65% WIN GOAL (РАЗБЛОКИРОВКА КЛЕШНИ)" style="font-size: 22px; color: #ffe600; letter-spacing: 2px;" />
            </ui:VisualElement>

            <!-- Score Percentage -->
            <ui:Label name="tv-score-text" text="100%" style="font-size: 56px; color: #ffe600;" />
        </ui:VisualElement>

        <!-- Main Gameplay Arena -->
        <ui:VisualElement name="gameplay-arena" style="flex-grow: 1; align-items: center; justify-content: center; position: relative;">
            
            <!-- 3x3 Dance Pad Grid -->
            <ui:VisualElement name="dance-pad-grid" style="width: 520px; height: 520px; flex-direction: column; justify-content: space-between;">
                <!-- Row 1: Q, W, E -->
                <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                    <ui:VisualElement class="arcade-card card-cyan" style="width: 150px; height: 150px; border-radius: 24px; align-items: center; justify-content: center; padding: 0; margin: 0;">
                        <ui:Label text="↖ Q" style="font-size: 48px; color: #ffffff;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="arcade-card card-pink" style="width: 150px; height: 150px; border-radius: 24px; align-items: center; justify-content: center; padding: 0; margin: 0;">
                        <ui:Label text="↑ W" style="font-size: 48px; color: #ffffff;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="arcade-card card-cyan" style="width: 150px; height: 150px; border-radius: 24px; align-items: center; justify-content: center; padding: 0; margin: 0;">
                        <ui:Label text="↗ E" style="font-size: 48px; color: #ffffff;" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Row 2: A, Center Burger, D -->
                <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                    <ui:VisualElement class="arcade-card card-pink" style="width: 150px; height: 150px; border-radius: 24px; align-items: center; justify-content: center; padding: 0; margin: 0;">
                        <ui:Label text="← A" style="font-size: 48px; color: #ffffff;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="arcade-card card-yellow" style="width: 150px; height: 150px; border-radius: 24px; align-items: center; justify-content: center; padding: 0; margin: 0; background-color: rgba(35, 18, 70, 0.95);">
                        <ui:Image style="width: 90px; height: 90px; background-image: url(&apos;project:/Assets/Art/Vectors/icon_burger_neon.svg&apos;); -unity-background-scale-mode: scale-to-fit;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="arcade-card card-pink" style="width: 150px; height: 150px; border-radius: 24px; align-items: center; justify-content: center; padding: 0; margin: 0;">
                        <ui:Label text="→ D" style="font-size: 48px; color: #ffffff;" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Row 3: Z, S, C -->
                <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                    <ui:VisualElement class="arcade-card card-cyan" style="width: 150px; height: 150px; border-radius: 24px; align-items: center; justify-content: center; padding: 0; margin: 0;">
                        <ui:Label text="↙ Z" style="font-size: 48px; color: #ffffff;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="arcade-card card-pink" style="width: 150px; height: 150px; border-radius: 24px; align-items: center; justify-content: center; padding: 0; margin: 0;">
                        <ui:Label text="↓ S" style="font-size: 48px; color: #ffffff;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="arcade-card card-cyan" style="width: 150px; height: 150px; border-radius: 24px; align-items: center; justify-content: center; padding: 0; margin: 0;">
                        <ui:Label text="↘ C" style="font-size: 48px; color: #ffffff;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Bottom Left Combo & Hit Status -->
            <ui:VisualElement style="position: absolute; left: 60px; bottom: 50px;">
                <ui:Label name="tv-combo-text" text="COMBO x48" style="font-size: 54px; color: #00f0ff; margin-bottom: 5px;" />
                <ui:Label name="tv-judge-text" text="PERFECT!" style="font-size: 44px; color: #00ff66; letter-spacing: 2px;" />
            </ui:VisualElement>

            <!-- Bottom Right Platform Hint -->
            <ui:VisualElement style="position: absolute; right: 60px; bottom: 50px; align-items: flex-end;">
                <ui:Label name="tv-platform-hint-1" text="ТАНЦЕВАЛЬНАЯ ПЛАТФОРМА" style="font-size: 26px; color: rgba(255, 255, 255, 0.6);" />
                <ui:Label name="tv-platform-hint-2" text="НАСТУПАЙТЕ НА СТРЕЛКИ В ТАКТ" style="font-size: 28px; color: #ff007f;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>