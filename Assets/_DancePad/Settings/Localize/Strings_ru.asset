  - m_Id: 846418765512704
    m_Localized: "\u0412\u044B\u0431\u043E\u0440 \u0442\u0440\u0435\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 846544946954240
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043F\u0435\u0441\u043D\u044E
      \u0438\u0437 5 \u0442\u0440\u0435\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 846950011863040
    m_Localized: "\u0412\u044B\u0431\u0440\u0430\u0442\u044C \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 847096422432768
    m_Localized: "\u041A \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 847219210682368
    m_Localized: "\u041B\u0451\u0433\u043A\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 847337460695040
    m_Localized: "\u0421\u0440\u0435\u0434\u043D\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 847440443441152
    m_Localized: "\u0422\u044F\u0436\u0451\u043B\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 847588896636928
    m_Localized: "\u0421\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u0439 \u0442\u0435\u043C\u043F,
      \u0431\u0430\u0437\u043E\u0432\u044B\u0435 \u0441\u0442\u0440\u0435\u043B\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 847842035466240
    m_Localized: "\u041A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0442\u0435\u043C\u043F \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 848178649333760
    m_Localized: "\u041C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u0430\u044F
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043A\u043E\u043C\u0431\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 848407909990400
    m_Localized: "\u0412\u044B\u0431\u043E\u0440 \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 848718540144640
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0442\u0435\u043C\u043F
      \u0434\u043B\u044F \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 848963873374208
    m_Localized: "\u041A\u0430\u043A \u0438\u0433\u0440\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 849057502822400
    m_Localized: "1. \u0412\u0441\u0442\u0430\u043D\u044C\u0442\u0435 \u043D\u0430
      \u0442\u0430\u043D\u0446\u0435\u0432\u0430\u043B\u044C\u043D\u0443\u044E \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0443\n2.
      \u0421\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u043D\u0430 \u0432\u0435\u0440\u043D\u0438\u0439
      \u0422\u0412-\u044D\u043A\u0440\u0430\u043D\n3. \u041D\u0430\u0441\u0442\u0443\u043F\u0430\u0439\u0442\u0435
      \u043D\u0430 \u0441\u0442\u0440\u0435\u043B\u043A\u0438 \u0442\u043E\u0447\u043D\u043E
      \u0432 \u0442\u0430\u043A\u0442 \u043C\u0443\u0437\u044B\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 849424290512896
    m_Localized: "\u0426\u0435\u043B\u044C - \u0447\u0438\u0442-\u043A\u043E\u0434
      \u043E\u0442 \u0433\u043E\u043B\u043E\u0434\u0430:"
    m_Metadata:
      m_Items: []
  - m_Id: 849559191912448
    m_Localized: "\u041D\u0430\u0431\u0435\u0440\u0438\u0442\u0435 \u043E\u0442 65%
      \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u0438, \u0447\u0442\u043E\u0431\u044B
      \u0440\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0441\u044D\u043D\u0434\u0432\u0438\u0447 \u0438\u0437 \u043A\u043B\u0435\u0448\u043D\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 849834023682048
    m_Localized: "\u041F\u043E\u043D\u044F\u0442\u043D\u043E, \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 849983978438656
    m_Localized: "\u0413\u043E\u0442\u043E\u0432\u044B \u043A \u0438\u0433\u0440\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 850167831560192
    m_Localized: "\u041D\u0430\u0447\u0430\u0442\u044C \u0438\u0433\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 850310878298112
    m_Localized: "\u041F\u043E\u0431\u0435\u0434\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 850396966387712
    m_Localized: "\u0427\u0438\u0442-\u043A\u043E\u0434 \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u043E\u0432\u0430\u043D!"
    m_Metadata:
      m_Items: []
  - m_Id: 850546057117696
    m_Localized: "\u041A\u043B\u0435\u0448\u043D\u044F \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u043E\u0432\u0430\u043D\u0430
      - \u0437\u0430\u0431\u0435\u0440\u0438\u0442\u0435 \u0441\u044D\u043D\u0434\u0432\u0438\u0447!"
    m_Metadata:
      m_Items: []
  - m_Id: 850686692130816
    m_Localized: "\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 850818674294784
    m_Localized: "\u0412\u0441\u0442\u0430\u043D\u044C\u0442\u0435 \u043D\u0430 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 850997066432512
    m_Localized: "\u0418 \u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u043D\u0430\u0432\u0435\u0440\u0445!"
    m_Metadata:
      m_Items: []
  - m_Id: 851141665062912
    m_Localized: "\u041F\u043E\u0447\u0442\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 851326357045248
    m_Localized: "\u0414\u043B\u044F \u043F\u043E\u0431\u0435\u0434\u044B \u043D\u0443\u0436\u043D\u043E
      \u0431\u044B\u043B\u043E \u2265 65%"
    m_Metadata:
      m_Items: []
  - m_Id: 851479528833024
    m_Localized: "\u041F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C
      \u0441\u043D\u043E\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 855477384216576
    m_Localized: "\u0418\u0434\u0451\u0442 \u0438\u0433\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 855589422465024
    m_Localized: "\u0421\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u043D\u0430 \u0432\u0435\u0440\u0445\u043D\u0438\u0439
      \u0442\u0432-\u044D\u043A\u0440\u0430\u043D!"
    m_Metadata:
      m_Items: []
